# ========================
# External tools (large binaries)
# ========================
# all downloaded by packaging/fetch_deps.ps1 (ffmpeg + node are > 100 MB, GitHub's file limit)
# "**/" is needed: a pattern with a "/" in the middle only matches from the repository root
**/tools/ffmpeg/
**/bin/node/
**/bin/yt-dlp.exe
**/bin/yt-dlp

